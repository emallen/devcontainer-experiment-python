# EditorConfig is awesome:http://EditorConfig.org

# See also:
# https://michaelcurrin.github.io/code-cookbook/recipes/other/editor-config.html
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
# Consistent with PEP 8, convenient since we use autopep8.
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
# A source for these choices can be found at
# https://github.com/microsoft/json-document-transforms/blob/main/.editorconfig
indent_style = space
indent_size = 2

[*.{[cC][mM][dD],[bB][aA][tT]}]
# In truth, we want IBM437; latin1 is the closest we may be able to get.
charset = latin1
end_of_line = crlf
