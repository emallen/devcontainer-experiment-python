{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // About comments: The VSCode release notes for version 1.19 documented
    // the addition of `jsonc` in addition to `json` format, as well as
    // noting that VSCode Configuration files are `jsonc` (JSON with Comments)
    // when published in November 2017.
    // https://code.visualstudio.com/updates/v1_19#_json-with-comments
    //
    // https://jsonc.org/ seems to be the JSON with Comments documentation.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Program",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/my_amazing_app.py",
            "console": "integratedTerminal"
        }
    ]
}
